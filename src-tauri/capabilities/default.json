{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the TAMIAS desktop window. Keeps the surface minimal — the app does its work entirely inside the embedded WebView, plus the updater plugin so the app can self-update.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://github.com/ArioMoniri/semikap" },
        { "url": "https://github.com/ArioMoniri/semikap/**" },
        { "url": "https://huggingface.co/Aralario/tamias-zenodo-liver-models/**" },
        { "url": "https://zenodo.org/**" },
        { "url": "https://www.cancerimagingarchive.net/**" },
        { "url": "http://medicaldecathlon.com/**" },
        { "url": "https://medicaldecathlon.com/**" },
        { "url": "https://msd-for-monai.s3-us-west-2.amazonaws.com/**" },
        { "url": "https://www.synapse.org/**" },
        { "url": "https://portal.imaging.datacommons.cancer.gov/**" }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
